# Environment Configuration for Production Deployment
# Copy this to .env.production and fill in your actual values

# ============================================
# REQUIRED: Google Gemini API
# ============================================
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_api_key_here

# ============================================
# REQUIRED: Flask Configuration
# ============================================
FLASK_ENV=production
FLASK_APP=frontend/app.py
DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here

# ============================================
# Server Configuration
# ============================================
PORT=5000
HOST=0.0.0.0

# ============================================
# OPTIONAL: Database (for production persistence)
# ============================================
# If using PostgreSQL instead of file-based storage
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db
# SQLALCHEMY_TRACK_MODIFICATIONS=False

# ============================================
# OPTIONAL: Redis (for caching & sessions)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# OPTIONAL: AWS S3 (for file uploads)
# ============================================
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# ============================================
# OPTIONAL: Google Cloud Storage
# ============================================
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================
# OPTIONAL: Error Tracking (Sentry)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# ============================================
# OPTIONAL: Application Logging
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/chatbot/app.log

# ============================================
# OPTIONAL: Email Notifications
# ============================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ADMIN_EMAIL=admin@example.com

# ============================================
# OPTIONAL: API Rate Limiting
# ============================================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=3600

# ============================================
# OPTIONAL: Allowed Origins (CORS)
# ============================================
# ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://app.example.com

# ============================================
# OPTIONAL: PDF Upload Settings
# ============================================
# MAX_PDF_SIZE_MB=200
# ALLOWED_PDF_EXTENSIONS=.pdf
# PDF_UPLOAD_TIMEOUT=300

# ============================================
# OPTIONAL: Model Configuration
# ============================================
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=1024

# ============================================
# OPTIONAL: Feature Flags
# ============================================
# ENABLE_PDF_UPLOAD=true
# ENABLE_WEB_SEARCH=true
# ENABLE_FILE_PERSISTENCE=true
# ENABLE_THREAD_HISTORY=true
